# Growth Report AI — Environment Variables
# Copy to .dev.vars for local Cloudflare Workers dev (wrangler reads .dev.vars)
# Copy to .env.local for plain `next dev` (no wrangler)

# Optional: base URL of the frxncois platform API for AI insight generation.
# If unset, the app falls back to deterministic mock data (demo mode).
NEXT_PUBLIC_FRXNCOIS_API=https://frxncois.com

# Demo bypass — set to "true" to skip auth on all (app) routes in local dev.
# NEVER set to "true" in production.
NEXT_PUBLIC_DEMO_MODE=true
